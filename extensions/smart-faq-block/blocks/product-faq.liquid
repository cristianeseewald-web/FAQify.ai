{%- assign faqs = product.metafields.smart_faq.items.value -%}
{%- if faqs != blank and faqs.size > 0 -%}
  <div class="smart-faq" style="--sf-accent: {{ block.settings.accent_color }}; --sf-text: {{ block.settings.text_color }};">
    {%- if block.settings.heading != blank -%}
      <h2 class="smart-faq__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for faq in faqs -%}
      <details class="smart-faq__item" {% if forloop.first and block.settings.open_first %}open{% endif %}>
        <summary class="smart-faq__question">{{ faq.question | escape }}</summary>
        <div class="smart-faq__answer">{{ faq.answer | escape | newline_to_br }}</div>
      </details>
    {%- endfor -%}
  </div>

  {%- if block.settings.seo_schema -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for faq in faqs -%}
            {
              "@type": "Question",
              "name": {{ faq.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}

  <style>
    .smart-faq { margin: 2rem 0; color: var(--sf-text); }
    .smart-faq__heading { margin: 0 0 1rem; }
    .smart-faq__item { border-bottom: 1px solid rgba(0,0,0,.12); }
    .smart-faq__question {
      cursor: pointer; list-style: none; padding: 1rem 2rem 1rem 0;
      font-weight: 600; position: relative;
    }
    .smart-faq__question::-webkit-details-marker { display: none; }
    .smart-faq__question::after {
      content: "+"; position: absolute; right: .25rem; top: 50%;
      transform: translateY(-50%); color: var(--sf-accent); font-size: 1.25em;
    }
    .smart-faq__item[open] .smart-faq__question::after { content: "−"; }
    .smart-faq__answer { padding: 0 0 1rem; line-height: 1.6; opacity: .85; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "seo_schema", "label": "Add FAQ schema for Google (SEO)", "default": true },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ]
}
{% endschema %}
